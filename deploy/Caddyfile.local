{
    admin off
    skip_install_trust
    auto_https disable_redirects
    https_port 8443
    default_sni 127.0.0.1
}

https://127.0.0.1:8443 {
    tls internal
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Cache-Control no-store
        -Server
    }
    reverse_proxy studio:3000
}
